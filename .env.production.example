# Production environment template.
# Used by `npm run build:prod` to inject Vite variables into compiled assets.
# Copy this file to `.env.production` and adjust the values, or override via
# shell environment variables (shell takes priority).

# --- Reverb (real-time) ---
VITE_REVERB_APP_KEY=pinjaminkey
VITE_REVERB_HOST=pinjam-in-reverb.up.railway.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
